#!/usr/bin/env python3
"""ocr-review — обёртка над Alibaba `ocr` CLI (github.com/alibaba/open-code-review).

Провайдер-агностик: обычный CLI, JSON на выходе, зависимостей нет кроме python3 и `ocr` в PATH.
Код не меняет: только читает git, зовёт модель и печатает findings.

Раскладка правил (важно для публичного репозитория скиллов):
  ПУБЛИЧНОЕ (можно коммитить):  <toolkit>/assets/rules/common.json, <toolkit>/assets/rules/stacks/**
  ПРИВАТНОЕ (никогда в git):    ~/.config/ocr-review/projects/<name>.json
                                ~/.config/ocr-review/repos.json   (какой репозиторий каким набором ревьюить)
                                ~/.config/ocr-review/leak-terms.txt (что не должно всплыть в публичных файлах)

Режимы:
  audit (default) — правки кода запрещены; отпечаток worktree сверяется до и после, при расхождении exit 3.
  fix             — правки разрешены; в конце подсказывает ocr session compare.

Приоритет правил (первый матч выигрывает): project (private) -> common -> stack -> <lang>/base.
"""
from __future__ import annotations

import argparse
import hashlib
import json
import os
import re
import shutil
import subprocess
import sys
import time
from pathlib import Path

TOOLKIT = Path(__file__).resolve().parent
CACHE = Path(os.environ.get("OCR_REVIEW_HOME", Path.home() / ".cache" / "ocr-review"))
PRIVATE = Path(os.environ.get("OCR_REVIEW_PRIVATE")
               or (Path(os.environ.get("XDG_CONFIG_HOME") or Path.home() / ".config") / "ocr-review"))
GATE_ORDER = {"n/a": 0, "low": 1, "medium": 2, "high": 3, "critical": 4}


def skill_dir() -> Path:
    """Корень скилла: правила лежат в assets/rules, скрипты в scripts/."""
    return TOOLKIT.parent if TOOLKIT.name == "scripts" else TOOLKIT


def rules_root() -> Path:
    override = os.environ.get("OCR_REVIEW_RULES")
    if override:
        return Path(override)
    for candidate in (TOOLKIT / "assets" / "rules", TOOLKIT.parent / "assets" / "rules", TOOLKIT / "rules"):
        if candidate.is_dir():
            return candidate
    sys.exit("ocr-review: не нашёл каталог правил (assets/rules или rules рядом со скриптом)")


# ---------- git ----------

def git(*args: str, cwd: Path) -> str:
    return subprocess.run(["git", *args], cwd=cwd, capture_output=True, text=True, check=True).stdout


def git_root(cwd: Path) -> Path:
    return Path(git("rev-parse", "--show-toplevel", cwd=cwd).strip())


def tree_fingerprint(root: Path) -> str:
    h = hashlib.sha256()
    h.update(git("status", "--porcelain=v1", "--untracked-files=all", cwd=root).encode())
    h.update(git("diff", "HEAD", cwd=root).encode())
    for name in git("ls-files", "--others", "--exclude-standard", cwd=root).splitlines():
        path = root / name
        if path.is_file():
            h.update(name.encode())
            h.update(hashlib.sha256(path.read_bytes()).digest())
    return h.hexdigest()


# ---------- профиль репозитория (приватный) ----------

def load_repo_profiles() -> dict[str, dict]:
    path = PRIVATE / "repos.json"
    if not path.is_file():
        return {}
    try:
        return (json.loads(path.read_text(encoding="utf-8")).get("repos") or {})
    except json.JSONDecodeError as exc:
        sys.exit(f"ocr-review: битый {path}: {exc}")


def profile_for(root: Path) -> dict:
    root_str = str(root)
    best: tuple[int, dict] | None = None
    for prefix, profile in load_repo_profiles().items():
        if root_str == prefix or root_str.startswith(prefix.rstrip("/") + "/"):
            if best is None or len(prefix) > best[0]:
                best = (len(prefix), profile)
    return best[1] if best else {}


# ---------- стек ----------

def detect_stack(root: Path) -> str:
    pkg = root / "package.json"
    if pkg.is_file():
        try:
            data = json.loads(pkg.read_text(encoding="utf-8", errors="replace"))
        except json.JSONDecodeError:
            data = {}
        deps: dict = {}
        for key in ("dependencies", "devDependencies"):
            deps.update(data.get(key) or {})
        names = set(deps)
        if any(n.startswith("@nestjs/") for n in names) or "typeorm" in names:
            return "typescript/nest-typeorm"
        if names & {"react", "next", "vue", "nuxt", "svelte", "@sveltejs/kit"}:
            return "typescript/react"
        return "typescript/base"
    if (root / "go.mod").is_file():
        return "go/base"
    if (root / "pyproject.toml").is_file() or (root / "requirements.txt").is_file():
        return "python/base"
    return "typescript/base"


# ---------- композиция правил ----------

def load_rules(path: Path) -> dict:
    try:
        return json.loads(path.read_text(encoding="utf-8"))
    except FileNotFoundError:
        return {}
    except json.JSONDecodeError as exc:
        sys.exit(f"ocr-review: битый файл правил {path}: {exc}")


def layer_list(stack: str, project: str | None) -> list[tuple[str, Path]]:
    rr = rules_root()
    layers: list[tuple[str, Path]] = []
    if project:
        private = PRIVATE / "projects" / f"{project}.json"
        public = rr / "projects" / f"{project}.json"
        if private.is_file():
            layers.append((f"project:{project} (private)", private))
        elif public.is_file():
            layers.append((f"project:{project} (public)", public))
        else:
            print(f"ocr-review: набор '{project}' не найден ни в {PRIVATE / 'projects'} "
                  f"ни в {rr / 'projects'} — работаю только на стековых правилах", file=sys.stderr)
    layers.append(("common", rr / "common.json"))
    layers.append((stack, rr / "stacks" / f"{stack}.json"))
    base = rr / "stacks" / stack.split("/")[0] / "base.json"
    if base != layers[-1][1]:
        layers.append((f"{stack.split('/')[0]}/base", base))
    return [(name, path) for name, path in layers if path.is_file()]


def compose_rules(stack: str, project: str | None) -> tuple[Path, list[tuple[str, Path]], dict]:
    layers = layer_list(stack, project)
    rules: list[dict] = []
    include: list[str] = []
    exclude: list[str] = []
    for _, path in layers:
        data = load_rules(path)
        rules.extend(data.get("rules") or [])
        include.extend(p for p in data.get("include") or [] if p not in include)
        exclude.extend(p for p in data.get("exclude") or [] if p not in exclude)

    deduped: list[dict] = []
    seen: set[str] = set()
    for entry in rules:
        pattern = entry.get("path", "")
        if pattern in seen:
            continue
        seen.add(pattern)
        deduped.append(entry)

    # Правила про тесты поднимаем в начало: иначе широкое правило проекта
    # (например "apps/foo/**/*.ts") съедает спеки, объявленные в стековом слое.
    def is_test_rule(entry: dict) -> bool:
        pattern = entry.get("path", "").lower()
        return "spec" in pattern or "test" in pattern

    deduped.sort(key=lambda entry: 0 if is_test_rule(entry) else 1)  # stable

    composed = {"include": include, "exclude": exclude, "rules": deduped}
    CACHE.mkdir(parents=True, exist_ok=True)
    out = CACHE / f"composed-{stack.replace('/', '-')}{'-' + project if project else ''}.json"
    out.write_text(json.dumps(composed, ensure_ascii=False, indent=2), encoding="utf-8")
    return out, layers, composed


# ---------- ocr ----------

def ocr_bin() -> str:
    override = os.environ.get("OCR_REVIEW_OCR_BIN")
    if override:
        return override
    found = shutil.which("ocr")
    if not found:
        sys.exit("ocr-review: `ocr` не найден в PATH (положи бинарник open-code-review в PATH "
                 "или задай OCR_REVIEW_OCR_BIN)")
    return found


def run_review(args, root: Path, rule_file: Path) -> tuple[int, dict | None, str, Path]:
    out_json = CACHE / "runs" / f"{root.name}-{time.strftime('%Y%m%d-%H%M%S')}.json"
    out_json.parent.mkdir(parents=True, exist_ok=True)

    cmd = [ocr_bin(), "review", "--format", "json", "--audience", "agent",
           "--output", str(out_json), "--rule", str(rule_file),
           "--effort", args.effort, "--timeout", str(args.timeout),
           "--concurrency", str(args.concurrency)]
    if args.max_tokens_budget:
        cmd += ["--max-tokens-budget", str(args.max_tokens_budget)]
    if args.from_ref:
        cmd += ["--from", args.from_ref]
    if args.to_ref:
        cmd += ["--to", args.to_ref]
    if args.commit:
        cmd += ["--commit", args.commit]
    if args.preview:
        cmd += ["--preview"]
    if args.background_file:
        cmd += ["--background-file", str(Path(args.background_file).resolve())]
    elif args.background:
        cmd += ["--background", args.background]
    if args.provider:
        cmd += ["--provider", args.provider]
    if args.model:
        cmd += ["--model", args.model]

    proc = subprocess.run(cmd, cwd=root, capture_output=True, text=True)
    doc = None
    if out_json.is_file():
        try:
            doc = json.loads(out_json.read_text(encoding="utf-8"))
        except json.JSONDecodeError:
            doc = None
    return proc.returncode, doc, (proc.stdout + proc.stderr).strip(), out_json


# ---------- вывод ----------

def severity_of(comment: dict) -> str:
    return str(comment.get("severity") or comment.get("level") or "n/a").lower()


def print_result(doc: dict | None, raw: str, artifact: Path, args) -> None:
    if doc is None:
        if raw:
            print(raw)
        print("ocr-review: ocr не отдал JSON", file=sys.stderr)
        return

    if args.preview:
        files = doc.get("files") or []
        if files:
            print(f"preview: reviewable {doc.get('reviewable_count', '?')} / {doc.get('total_files', len(files))}"
                  f" · +{doc.get('total_insertions', '?')}/-{doc.get('total_deletions', '?')}")
            for f in files:
                mark = "✓" if f.get("will_review") else "✗"
                reason = f.get("excluded_reason") or f.get("reason") or ""
                line = (f"  {mark} {f.get('path')} [{f.get('status')}]"
                        f" +{f.get('insertions', 0)}/-{f.get('deletions', 0)}")
                print(line + (f"  ({reason})" if reason else ""))
        elif raw:
            print(raw)
        if args.json:
            print(json.dumps(doc, ensure_ascii=False, indent=2))
        return

    comments = doc.get("comments") or []
    summary = doc.get("summary") or {}
    status = doc.get("status", "?")
    if summary:
        print(f"ocr: {status} · файлов {summary.get('files_reviewed', '?')} · "
              f"комментов {summary.get('comments', len(comments))} · "
              f"токенов {summary.get('total_tokens', '?')} · {summary.get('elapsed', '?')}")
    else:
        msg = f" · {doc['message']}" if doc.get("message") else ""
        print(f"ocr: {status}{msg}")

    if summary.get("budget_exceeded"):
        print(f"  🔴 бюджет исчерпан: ревью неполное (status={status}). "
              f"Увеличь --max-tokens-budget или снизь --effort.", file=sys.stderr)

    for warn in doc.get("warnings") or []:
        message = warn.get("message") if isinstance(warn, dict) else warn
        files = warn.get("file") if isinstance(warn, dict) else ""
        print(f"  ⚠ {message}" + (f"  [{str(files)[:80]}]" if files else ""), file=sys.stderr)

    for c in comments:
        loc = f"{c.get('path', '?')}:{c.get('start_line', '?')}"
        if c.get("end_line") and c.get("end_line") != c.get("start_line"):
            loc += f"-{c['end_line']}"
        print(f"\n{loc} [{severity_of(c)}]\n  {str(c.get('content', '')).strip()}")
        if c.get("suggestion_code"):
            print("  --- предложено ---")
            for line in str(c["suggestion_code"]).splitlines():
                print(f"  {line}")

    if doc.get("session_id"):
        print(f"\nsession: {doc['session_id']}")
        print(f"продолжить: ocr review --resume {doc['session_id']}")
    print(f"artifact: {artifact}")


def doctor(root: Path, stack: str, project: str | None) -> int:
    rr = rules_root()
    layers = layer_list(stack, project)
    print(f"toolkit:  {TOOLKIT}")
    print(f"скилл:    {skill_dir()}")
    print(f"правила:  {rr}  ({'ПУБЛИЧНЫЕ' if 'dotfiles' in str(rr) else 'локальные'})")
    print(f"приватно: {PRIVATE}")
    print(f"repo:     {root}")
    print(f"профиль:  {profile_for(root) or '—'}")
    print(f"стек:     {stack}")
    print("слои:")
    for name, path in layers:
        print(f"  - {name}: {path}")
    if not layers:
        print("  (пусто — правила не найдены)")

    terms_file = PRIVATE / "leak-terms.txt"
    if terms_file.is_file():
        terms = [t.strip() for t in terms_file.read_text(encoding="utf-8").splitlines()
                 if t.strip() and not t.startswith("#")]
        hits: list[str] = []
        for path in skill_dir().rglob("*"):
            if not path.is_file() or path.suffix in {".png", ".jpg", ".svg", ".zip", ".gz"}:
                continue
            text = path.read_text(encoding="utf-8", errors="ignore").lower()
            for term in terms:
                if term.lower() in text:
                    hits.append(f"{path}: {term}")
        if hits:
            print("\n🔴 в публичных правилах найдены приватные термины:")
            for hit in hits:
                print(f"  {hit}")
            return 4
        print(f"\n🟢 утечек нет ({len(terms)} терминов проверено)")
    else:
        print(f"\n⚪ {terms_file} нет — проверка на утечки пропущена")
    return 0


def _read_env_file(path: Path) -> dict[str, str]:
    data: dict[str, str] = {}
    if not path.is_file():
        return data
    for line in path.read_text(encoding="utf-8", errors="replace").splitlines():
        line = line.strip()
        if not line or line.startswith("#") or "=" not in line:
            continue
        key, value = line.split("=", 1)
        data[key.strip()] = value.strip().strip('"').strip("'")
    return data


def _expand(value: str, lookup: dict[str, str]) -> str:
    """Раскрывает $VAR и ${VAR} по словарю. Нужно, чтобы не копировать секреты."""
    def repl(match: re.Match) -> str:
        name = match.group(1) or match.group(2)
        return lookup.get(name, "")
    return re.sub(r"\$\{([A-Za-z_][A-Za-z0-9_]*)\}|\$([A-Za-z_][A-Za-z0-9_]*)", repl, value)


def load_provider_env() -> None:
    """Провайдер для ocr, в порядке приоритета:
       1) реальное окружение (непустое значение)
       2) ~/.config/ocr-review/provider.env  — приватный файл, поддерживает ${OTHER_VAR}
       3) $HERMES_HOME/.env (по умолчанию /data/.hermes/.env) — откуда берём значения для ${...}
    Секреты не дублируются: в provider.env достаточно ссылки на переменную.
    """
    hermes_env = _read_env_file(Path(os.environ.get("HERMES_HOME", "/data/.hermes")) / ".env")
    lookup = {**hermes_env, **{k: v for k, v in os.environ.items() if v}}

    provider = _read_env_file(PRIVATE / "provider.env")
    # если в provider.env токен не задан, но в env-файле есть готовый OCR_LLM_*, берём его
    for key, value in lookup.items():
        if key.startswith("OCR_LLM_") and not provider.get(key):
            provider[key] = value

    merged = {**lookup, **{k: v for k, v in provider.items() if v}}
    for key, raw in provider.items():
        if os.environ.get(key):
            continue
        value = _expand(raw, merged)
        if value:
            os.environ[key] = value


def main() -> int:
    load_provider_env()
    p = argparse.ArgumentParser(prog="ocr-review", description="Ревью диффа через Alibaba ocr")
    p.add_argument("--repo", default=".")
    p.add_argument("--mode", choices=["audit", "fix"], default="audit",
                   help="audit: правки кода запрещены (проверяется отпечатком). fix: разрешены.")
    p.add_argument("--project", help="приватный набор правил ~/.config/ocr-review/projects/<name>.json")
    p.add_argument("--stack", help="rules/stacks/<name>.json, иначе автоопределение")
    p.add_argument("--from", dest="from_ref")
    p.add_argument("--to", dest="to_ref")
    p.add_argument("--commit")
    p.add_argument("--background")
    p.add_argument("--background-file")
    p.add_argument("--effort", default="medium", choices=["low", "medium", "high"])
    p.add_argument("--max-tokens-budget", type=int, default=900_000,
                   help="потолок токенов на весь прогон; ~30k на файл при effort medium")
    p.add_argument("--timeout", type=int, default=15)
    p.add_argument("--concurrency", type=int, default=8)
    p.add_argument("--provider")
    p.add_argument("--model")
    p.add_argument("--preview", action="store_true", help="только выбор файлов, без токенов")
    p.add_argument("--json", action="store_true", help="сырой JSON")
    p.add_argument("--gate", action="store_true", help="exit 1 при findings >= --gate-min нужной severity")
    p.add_argument("--gate-min", type=int, default=1)
    p.add_argument("--gate-severity", default="high", choices=list(GATE_ORDER)[1:])
    p.add_argument("--rules-only", action="store_true", help="показать собранные правила, без ревью")
    p.add_argument("--doctor", action="store_true", help="что откуда берётся + проверка утечек")
    p.add_argument("--llm-test", action="store_true", help="проверить провайдера: ocr llm test")
    args = p.parse_args()

    root = git_root(Path(args.repo).resolve())
    profile = profile_for(root)
    stack = args.stack or profile.get("stack") or detect_stack(root)
    project = args.project or profile.get("project")

    if args.llm_test:
        proc = subprocess.run([ocr_bin(), "llm", "test"], cwd=root, capture_output=True, text=True)
        print((proc.stdout + proc.stderr).strip())
        if "Tool-call round trip unverified" in proc.stdout + proc.stderr:
            print("\n🔴 модель не умеет tool calling - ревью будет слепым", file=sys.stderr)
            return 1
        return proc.returncode

    if args.doctor:
        return doctor(root, stack, project)

    rule_file, layers, composed = compose_rules(stack, project)

    if args.rules_only:
        print(f"repo:  {root}\nstack: {stack}\nproject: {project or '—'}"
              f"\nrules: {len(composed['rules'])}, include: {len(composed['include'])}")
        print("слои:")
        for name, path in layers:
            print(f"  - {name}: {path}")
        print(f"файл: {rule_file}")
        return 0

    before = tree_fingerprint(root)
    code, doc, raw, artifact = run_review(args, root, rule_file)
    after = tree_fingerprint(root)

    changed_during = before != after
    print_result(doc, raw, artifact, args)

    if args.mode == "audit" and changed_during:
        print("\n🔴 AUDIT VIOLATION: рабочее дерево изменилось во время ревью.\n"
              "   В режиме audit править код нельзя. Откати правки и прогони заново.\n"
              f"   repo: {root}", file=sys.stderr)
        return 3

    if args.gate and doc:
        comments = doc.get("comments") or []
        threshold = GATE_ORDER[args.gate_severity]
        blocking = [c for c in comments if GATE_ORDER.get(severity_of(c), 0) >= threshold]
        if len(blocking) >= args.gate_min:
            print(f"\n🔴 gate: {len(blocking)} findings severity >= {args.gate_severity}", file=sys.stderr)
            return 1
        print(f"\n🟢 gate: нет findings severity >= {args.gate_severity}")

    if args.mode == "fix" and doc and doc.get("comments"):
        print("\nдальше: правь код по списку и повтори тот же вызов.")
        if doc.get("session_id"):
            print(f"сравнить до/после: ocr session compare {doc['session_id']} <новый-сеанс>")

    return 0 if code == 0 else 1


if __name__ == "__main__":
    sys.exit(main())
